<view class="page">
  <view class="hero-panel">
    <view class="hero-head">
      <view class="hero-copy">
        <view class="eyebrow">月度工资台账</view>
        <view class="title">本月工资</view>
        <view class="subtitle">{{monthLabel}} · {{workDays}} 天上班 · {{paidDays}} 天带薪</view>
      </view>
      <view class="hero-total">
        <text class="hero-currency">¥</text>
        <text class="hero-amount">{{monthTotal}}</text>
      </view>
    </view>

    <view class="progress-block">
      <view class="progress-meta">
        <text>满勤进度</text>
        <text>{{workProgressLabel}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{workProgressPercent}}%;"></view>
      </view>
    </view>

    <view class="hero-stats">
      <view class="stat-item">
        <text class="stat-value">{{workDays}}</text>
        <text class="stat-label">上班天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{paidDays}}</text>
        <text class="stat-label">带薪天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{workProgressPercent}}%</text>
        <text class="stat-label">满勤比例</text>
      </view>
    </view>
  </view>

  <view class="settings-panel">
    <view class="field field-primary">
      <text class="field-label">日薪</text>
      <input class="field-input field-input-large" type="digit" value="{{dailySalary}}" placeholder="0" bindinput="onSalaryInput" />
      <text class="field-unit">元 / 天</text>
    </view>
    <view class="field">
      <text class="field-label">应上天数</text>
      <input class="field-input" type="digit" value="{{expectedWorkDays}}" placeholder="26" bindinput="onExpectedWorkDaysInput" />
    </view>
    <view class="field">
      <text class="field-label">满勤工资</text>
      <input class="field-input" type="digit" value="{{fullMonthSalary}}" placeholder="7500" bindinput="onFullMonthSalaryInput" />
    </view>
  </view>

  <view class="calendar-shell">
    <view class="month-row">
      <view class="icon-button" role="button" aria-label="上个月" bindtap="goPrevMonth">
        <view class="chevron chevron-prev"></view>
      </view>
      <view class="month-name">{{monthLabel}}</view>
      <view class="icon-button" role="button" aria-label="下个月" bindtap="goNextMonth">
        <view class="chevron chevron-next"></view>
      </view>
    </view>

    <view class="calendar">
      <view class="weekdays">
        <text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="days">
        <view
          wx:for="{{calendarDays}}"
          wx:key="key"
          class="day {{item.isCurrentMonth ? '' : 'muted'}} {{item.date === selectedDate ? 'selected' : ''}} {{item.record.type}}"
          data-date="{{item.date}}"
          bindtap="selectDate"
        >
          <text class="day-number">{{item.day}}</text>
          <text wx:if="{{item.record.label}}" class="day-tag">{{item.record.label}}</text>
          <text wx:else class="day-tag empty">休</text>
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{selectedDate}}">
    <view class="editor">
      <view class="editor-head">
        <view class="editor-copy">
          <view class="editor-kicker">已选日期</view>
          <view class="editor-title">{{selectedDateLabel}}</view>
        </view>
        <view class="editor-amount">{{selectedAmountLabel}}</view>
        <view class="clear-button" role="button" bindtap="clearSelectedDate">清空</view>
      </view>

      <view class="status-tabs">
        <view class="status-tab {{selectedRecord.type === 'work' ? 'active work' : ''}}" role="button" data-type="work" bindtap="setSelectedType">
          <view class="status-mark status-work"></view>
          <text>上班</text>
        </view>
        <view class="status-tab {{selectedRecord.type === 'paid' ? 'active paid' : ''}}" role="button" data-type="paid" bindtap="setSelectedType">
          <view class="status-mark status-paid"></view>
          <text>带薪</text>
        </view>
        <view class="status-tab {{selectedRecord.type === 'off' ? 'active off' : ''}}" role="button" data-type="off" bindtap="setSelectedType">
          <view class="status-mark status-off"></view>
          <text>不上班</text>
        </view>
      </view>

      <view class="work-duration" wx:if="{{selectedRecord.type === 'work'}}">
        <text class="setting-label">上班时长</text>
        <view class="duration-tabs">
          <view class="duration-tab {{selectedRecord.multiplier === '0.5' ? 'active' : ''}}" role="button" data-multiplier="0.5" bindtap="setWorkMultiplier">半天</view>
          <view class="duration-tab {{selectedRecord.multiplier === '1' ? 'active' : ''}}" role="button" data-multiplier="1" bindtap="setWorkMultiplier">全天</view>
        </view>
      </view>

      <view class="multiplier-row" wx:if="{{selectedRecord.type === 'paid'}}">
        <text class="setting-label">带薪倍数</text>
        <view class="multiplier-control">
          <input class="multiplier-input" type="digit" value="{{selectedRecord.multiplier}}" placeholder="2" bindinput="onMultiplierInput" />
          <text class="multiplier-unit">薪</text>
        </view>
      </view>
    </view>
  </block>
  <view class="editor empty-editor" wx:if="{{!selectedDate}}">
    <view class="empty-title">选择日期</view>
    <view class="empty-subtitle">记录上班、半天班或带薪假</view>
  </view>

  <view class="summary-spacer"></view>
  <view class="summary">
    <view>
      <view class="summary-label">本月合计</view>
      <view class="summary-detail">{{summaryModeLabel}}</view>
    </view>
    <view class="summary-amount">¥{{monthTotal}}</view>
  </view>
</view>
